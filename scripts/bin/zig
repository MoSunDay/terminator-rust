#!/bin/sh
# zig launcher: prefer the pypi ziglang wheel path this env pinned
# (ziglang.org unreachable), else PATH, else `python3 -m ziglang`.
ZIG_WHEEL=/usr/local/lib/python3.10/dist-packages/ziglang/zig
if [ -x "$ZIG_WHEEL" ]; then
  exec "$ZIG_WHEEL" "$@"
elif command -v zig >/dev/null 2>&1; then
  exec zig "$@"
elif python3 -m ziglang --version >/dev/null 2>&1; then
  exec python3 -m ziglang "$@"
else
  echo "zig not found. Install with: pip install ziglang==0.16.0 (or brew install zig)" >&2
  exit 1
fi
